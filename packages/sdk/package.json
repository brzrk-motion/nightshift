{
  "name": "@nightshift/sdk",
  "version": "0.1.0",
  "description": "The public interface plugins are written against.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nightshift/automations": "workspace:*",
    "@nightshift/core": "workspace:*",
    "@nightshift/entities": "workspace:*",
    "@nightshift/ui": "workspace:*",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "vitest": "^3.2.4"
  }
}
