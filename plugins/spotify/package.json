{
  "name": "@nightshift/plugin-spotify",
  "version": "0.1.0",
  "description": "Spotify Connect control — playlists, podcasts, and transport. No audio streaming.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nightshift/sdk": "workspace:*",
    "@opentui/react": "^0.5.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@nightshift/entities": "workspace:*",
    "@nightshift/ui": "workspace:*",
    "@types/react": "^19.2.18"
  }
}
