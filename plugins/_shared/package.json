{
  "name": "@nightshift/plugin-shared",
  "version": "0.1.0",
  "description": "Shared helpers for Nightshift plugins (not a loadable plugin).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nightshift/sdk": "workspace:*"
  },
  "devDependencies": {
    "@nightshift/entities": "workspace:*"
  }
}
