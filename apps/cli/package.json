{
  "name": "@nightshift/cli",
  "version": "0.1.0",
  "description": "The Nightshift command line interface.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nightshift": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nightshift/core": "workspace:*",
    "@nightshift/dashboard": "workspace:*",
    "@nightshift/plugin-focus": "workspace:*",
    "@nightshift/services": "workspace:*",
    "@nightshift/ui": "workspace:*",
    "@nightshift/vibes": "workspace:*",
    "commander": "^14.0.2"
  }
}
